# Copy this file to .env for local development and fill in real values.
# .env is git-ignored — never commit actual credentials.
#
# AWS deployment: store these in AWS Secrets Manager or Systems Manager
# Parameter Store, then reference them in your ECS task definition or
# Elastic Beanstalk environment properties. The startup script reads them
# from the injected environment automatically — no .env file needed in AWS.

# Postgres container init (used by the postgres image on first start)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend app database connection
DB_NAME=bowling
DB_USER=
DB_PASSWORD=